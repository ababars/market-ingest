# Copy to .env and fill in.  chmod 600 .env  -- it holds the root password.
#   cp .env.example .env && chmod 600 .env

# ---------------------------------------------------------------- connection
VPS_HOST=203.0.113.10           # IP or DNS name of the server
VPS_ALIAS=hash7                 # short name: `ssh hash7`, `ssh hash7-root`
SSH_PORT=22
SSH_KEY=~/.ssh/id_ed25519       # private key; .pub next to it is what gets copied

# Only needed for the very first run of bootstrap.sh (initial key upload).
# Clear it afterwards - once the key is in place the password buys nothing.
VPS_ROOT_PASS=

# ---------------------------------------------------------------- server user
VPS_USER=fenrir                 # non-root account created on the server
VPS_TZ=UTC                      # UTC on a data-collection box: exchange
                                # timestamps are UTC, and so are the logs
SWAP_SIZE=2G                    # swap file size; 0 to skip creating one

# Optional: git identity configured for root and VPS_USER on the server.
GIT_USER_NAME=
GIT_USER_EMAIL=

# ---------------------------------------------------------------- hardening
# prohibit-password = root may log in by key but never by password (default,
#                     keeps provisioning re-runnable)
# no                = root login disabled entirely; re-provisioning then has to
#                     go through VPS_USER + sudo
HARDEN_ROOT_LOGIN=prohibit-password

# ---------------------------------------------------------------- packages
INSTALL_DOCKER=1                # 0 to skip step 40-docker entirely

# ---------------------------------------------------------------- clickhouse
CH_DB=market                    # database created for exchange data
CH_PASSWORD=                    # empty -> generated and saved to
                                # /root/.clickhouse-credentials on the server
CH_MEM_RATIO=0.5                # share of RAM ClickHouse may use (0.5 of 12G = 6G)
CH_MAX_MEMORY=                  # absolute cap in bytes, overrides the ratio

# ---------------------------------------------------------------- netdata
# Optional. Set these to have the agent connect to Netdata Cloud, which is what
# makes the dashboard reachable from a phone WITHOUT opening any inbound port:
# the agent dials out, nothing listens on the public interface.
# Get them at https://app.netdata.cloud -> Space -> Connect Nodes.
NETDATA_CLAIM_TOKEN=
NETDATA_CLAIM_ROOMS=

# Optional: where Netdata's built-in alerts (disk filling up, RAM pressure,
# service down) should be delivered. Without these the alerts still fire, they
# just stay inside the dashboard.
NETDATA_TG_BOT_TOKEN=
NETDATA_TG_CHAT_ID=

# ---------------------------------------------------------------- steps
# Space-separated list to run a subset:  STEPS="50-clickhouse 60-netdata"
# Empty = all of them, in order.
STEPS=
